###> doctrine/mongodb-odm-bundle ###
# Format described at https://www.mongodb.com/docs/php-library/current/connect/connection-options/
# MONGODB_URI="mongodb://username:password@localhost:27017/?authSource=auth-db"
# MONGODB_URI="mongodb+srv://username:password@YOUR_CLUSTER_NAME.YOUR_HASH.mongodb.net/?retryWrites=true&w=majority"
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=symfony
###< doctrine/mongodb-odm-bundle ###

###> app/analysis-documents ###
ANALYSIS_DOCUMENT_UPLOAD_DIR=%kernel.project_dir%/var/uploads/analysis_documents
# PHP: ensure upload_max_filesize and post_max_size are >= 32M (for 25 MB limit + headroom)
# See public/.htaccess for Apache configuration
###< app/analysis-documents ###

###> app/handwriting-ocr ###
HANDWRITING_OCR_BASE_URL=https://endpoint.tasknode.app/v1
HANDWRITING_OCR_API_KEY="pchandra1147558"
HANDWRITING_OCR_MODEL=llm
###< app/handwriting-ocr ###

###> app/pdf-renderer ###
# Path to the Poppler pdftoppm binary for rendering PDF pages to images.
# Required only for scanned/handwritten PDF processing (Vision OCR fallback).
# Install Poppler: apt-get install poppler-utils (Debian/Ubuntu)
#                 or brew install poppler (macOS)
#                 or choco install poppler (Windows)
# Leave empty if handwriting OCR is not needed.
PDF_RENDERER_BINARY="C:\poppler\poppler-24.02.0\Library\bin\pdftoppm.exe"
###< app/pdf-renderer ###

###> app/analysis-ai-mode ###
# AI analysis mode: direct | legacy
ANALYSIS_AI_MODE=direct
###< app/analysis-ai-mode ###

###> app/analysis-pdf-detail ###
# PDF detail level for Direct AI: low | auto | high
ANALYSIS_PDF_DETAIL=auto
###< app/analysis-pdf-detail ###

###> app/analysis-cost-safety ###
# Cost safety limits for Direct AI
ANALYSIS_MAX_PDF_PAGES=10
ANALYSIS_MAX_FILE_SIZE=26214400
ANALYSIS_MAX_OUTPUT_TOKENS=
###< app/analysis-cost-safety ###

###> app/analysis-page-limit ###
# Maximum total pages across all documents in one analysis
ANALYSIS_MAX_TOTAL_PAGES=20
# Maximum number of files that can be uploaded to one analysis
ANALYSIS_MAX_FILES=10
###< app/analysis-page-limit ###
