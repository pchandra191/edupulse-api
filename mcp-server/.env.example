NODE_ENV=development
PORT=8787
HOST=0.0.0.0

# Public HTTPS URL of the MCP endpoint, including /mcp.
MCP_PUBLIC_URL=http://localhost:8787/mcp
# OAuth issuer is the origin hosting the OAuth endpoints.
MCP_ISSUER_URL=http://localhost:8787
# Resource identifier sent in OAuth requests; use the exact public MCP URL in production.
MCP_RESOURCE_URL=http://localhost:8787/mcp
MCP_DOCUMENTATION_URL=

# Symfony API base URL including /api/v1.
EDUPULSE_API_BASE_URL=http://localhost:8000/api/v1

# PostgreSQL database dedicated to MCP OAuth state/token tables.
DATABASE_URL=postgresql://edupulse_mcp:change-me@localhost:5432/edupulse_mcp
DATABASE_SSL=false

# Generate with: openssl rand -base64 32
# Keep stable across deployments and never commit the real value.
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# Comma-separated browser origins; leave only the origins actually used by your client.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
